{
  "format": "riftcity-city-block",
  "version": 2,
  "blueprint_version": 1,
  "id": "blueprint-example-downtown-cross",
  "name": "Blueprint Example — Downtown Cross",
  "units": "meters",
  "grid": {
    "cell_size": 1,
    "shape_increment": 0.5
  },
  "origin": [0, 0, 0],
  "bounds": {
    "min": [0, 0, 0],
    "max": [63, 7, 63]
  },
  "palette": {
    "air": { "material_id": 0, "shape": "air", "color": [0, 0, 0] },
    "brick": { "material_id": 1, "shape": "full", "color": [0.46, 0.25, 0.20] },
    "concrete": { "material_id": 2, "shape": "full", "color": [0.66, 0.65, 0.61] },
    "asphalt": { "material_id": 3, "shape": "full", "color": [0.16, 0.17, 0.18] },
    "roof": { "material_id": 4, "shape": "full", "color": [0.20, 0.21, 0.22] },
    "stair_n": { "material_id": 2, "shape": "stair", "rotation": "north", "color": [0.66, 0.65, 0.61] }
  },
  "prefabs": {
    "stoop": {
      "kind": "entrance",
      "bounds": { "min": [0, 0, 0], "max": [2, 1, 1] },
      "tags": ["entrance", "walkup"],
      "ops": [
        { "op": "fill_box", "state": "concrete", "min": [0, 0, 0], "max": [2, 0, 1] },
        { "op": "set", "state": "stair_n", "at": [1, 1, 0] }
      ],
      "anchors": {
        "door": { "at": [1, 1, 0], "facing": "north", "tags": ["door"] }
      }
    },
    "shop_shell": {
      "kind": "storefront",
      "bounds": { "min": [0, 0, 0], "max": [9, 5, 8] },
      "tags": ["building", "commercial"],
      "ops": [
        {
          "op": "hollow_box",
          "state": "brick",
          "roof_state": "roof",
          "floor": true,
          "wall_thickness": 1,
          "min": [0, 0, 0],
          "max": [9, 5, 8]
        }
      ],
      "instances": [
        { "id": "stoop", "prefab": "stoop", "origin": [3, 0, 0], "rotation": "north" }
      ],
      "anchors": {
        "street": { "at": [4, 0, 8], "facing": "south", "tags": ["frontage"] }
      }
    },
    "corner_pair": {
      "kind": "city-block-piece",
      "bounds": { "min": [0, 0, 0], "max": [21, 5, 18] },
      "tags": ["downtown", "commercial"],
      "instances": [
        { "id": "shop-west", "prefab": "shop_shell", "origin": [0, 0, 0], "rotation": "north" },
        { "id": "shop-east", "prefab": "shop_shell", "origin": [11, 0, 0], "rotation": "north" }
      ],
      "anchors": {
        "street_link": { "at": [10, 0, 18], "facing": "south", "tags": ["road-link"] }
      }
    }
  },
  "anchors": {
    "block-a-frontage": { "at": [13, 0, 20], "facing": "north", "tags": ["frontage"] },
    "block-b-frontage": { "at": [58, 0, 13], "facing": "west", "tags": ["frontage"] },
    "main-road-west": { "at": [0, 0, 30], "facing": "west", "tags": ["road"] },
    "main-road-east": { "at": [63, 0, 30], "facing": "east", "tags": ["road"] }
  },
  "layout": [
    {
      "type": "instance",
      "id": "block-a",
      "prefab": "corner_pair",
      "origin": [3, 0, 2],
      "rotation": "north",
      "group": "north-frontage"
    },
    {
      "type": "instance",
      "id": "block-b",
      "prefab": "corner_pair",
      "origin": [40, 0, 2],
      "rotation": "west",
      "group": "north-frontage"
    },
    {
      "type": "road",
      "id": "main-road",
      "from": [0, 0, 30],
      "to": [63, 0, 30],
      "width": 6,
      "state": "asphalt",
      "sidewalk": { "width": 3, "state": "concrete" },
      "curb": { "width": 1, "state": "concrete" },
      "tags": ["road", "east-west"]
    },
    {
      "type": "road",
      "id": "cross-road",
      "from": [31, 0, 24],
      "to": [31, 0, 63],
      "width": 6,
      "state": "asphalt",
      "sidewalk": { "width": 3, "state": "concrete" },
      "curb": { "width": 1, "state": "concrete" },
      "tags": ["road", "north-south"]
    },
    {
      "type": "intersection",
      "id": "main-junction",
      "center": [31, 0, 30],
      "size": [6, 6],
      "state": "asphalt",
      "sidewalk": { "width": 3, "state": "concrete" },
      "curb": { "width": 1, "state": "concrete" },
      "tags": ["road", "intersection"]
    }
  ],
  "groups": {
    "district-core": {
      "members": [
        "block-a",
        "block-b",
        "main-road",
        "main-junction",
        "block-a/shop-west/stoop.door",
        "block-b.street_link"
      ],
      "tags": ["downtown", "example"]
    }
  },
  "connections": [
    {
      "from": "block-a.street_link",
      "to": "block-a-frontage",
      "tolerance": 0,
      "require_opposite_facing": true,
      "tags": ["frontage"]
    },
    {
      "from": "block-b.street_link",
      "to": "block-b-frontage",
      "tolerance": 0,
      "require_opposite_facing": true,
      "tags": ["frontage"]
    }
  ],
  "validation": {
    "overlap_policy": "error",
    "max_validation_cells": 3000000
  }
}
